{
  "name": "pi-subagent-monitor",
  "version": "0.6.2",
  "description": "Pi extension and embeddable TUI component to monitor pi-subagents activity from the history SQLite database.",
  "type": "module",
  "license": "MIT",
  "author": "thunder609",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thunder609/pi-subagent-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/thunder609/pi-subagent-monitor/issues"
  },
  "homepage": "https://github.com/thunder609/pi-subagent-monitor#readme",
  "keywords": [
    "pi",
    "coding-agent",
    "subagents",
    "monitor",
    "tui",
    "extension",
    "dashboard"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0",
    "@earendil-works/pi-tui": ">=0.84.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/generator": "^7.29.8",
    "@babel/parser": "^7.29.8",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@types/node": "^22.5.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "pi": {
    "extensions": [
      "dist/index.js"
    ]
  },
  "dependencies": {
    "pi-subagent-monitor": "^0.6.1"
  }
}
